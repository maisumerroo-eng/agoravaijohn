{
  // Cloudflare Workers (grátis, sem cartão): https://agoravaijohn.maisumerroo.workers.dev
  "name": "agoravaijohn",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true, // não apaga variáveis criadas no painel da Cloudflare
  "observability": { "enabled": true }
}
